# ClauseFlow — Production environment variables
# Copy this to .env.prod and fill every value before deploying.
# The deploy.sh script auto-generates the secret values for you.

# ── Domain ────────────────────────────────────────────────────────────────────
# Your domain name (no https://, no trailing slash)
DOMAIN=app.yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
# Strong random password for the bundled postgres container — deploy.sh generates
# this automatically. Required even when using an external database, because the
# db container still boots.
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Postgres connection pool size per process (app + worker each). Leave empty for
# the default of 20.
DATABASE_POOL_SIZE=

# Leave both empty to use the bundled postgres container.
#
# To use an external database instead (e.g. Supabase), set DATABASE_URL to the
# pooled connection and DIRECT_URL to the direct one. DIRECT_URL is required
# whenever DATABASE_URL goes through a transaction pooler: `prisma migrate deploy`
# takes an advisory lock and runs DDL, neither of which survives one.
#   DATABASE_URL=postgresql://postgres.[ref]:[pw]@aws-1-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
#   DIRECT_URL=postgresql://postgres.[ref]:[pw]@aws-1-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=
DIRECT_URL=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Storage (MinIO) ──────────────────────────────────────────────────────────
MINIO_ROOT_USER=clauseflow
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Storage (Cloudflare R2 — use instead of MinIO for a managed bucket) ───────
# Cloudflare dashboard → R2 → Manage API tokens → Create API token
# ("Object Read & Write", scoped to your bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Auth ──────────────────────────────────────────────────────────────────────
# 32+ random bytes — deploy.sh generates this automatically
BETTER_AUTH_SECRET=REPLACE_WITH_SECRET

# ── Notification encryption (required for Slack/Teams webhooks) ───────────────
# 32+ random bytes — deploy.sh generates this automatically
NOTIFICATION_ENCRYPTION_KEY=REPLACE_WITH_SECRET

# ── Email (Postmark) ──────────────────────────────────────────────────────────
# Postmark dashboard → Servers → your server → API Tokens → Server API Token.
# Then verify your sending domain (Sender Signatures → Domains) and add the DKIM
# + Return-Path DNS records Postmark gives you. Postmark rejects mail from an
# unverified From address, so EMAIL_FROM must be on the verified domain.
POSTMARK_SERVER_TOKEN=REPLACE_WITH_YOUR_POSTMARK_SERVER_TOKEN
# Transactional stream every Postmark server ships with — change only for a custom stream.
POSTMARK_MESSAGE_STREAM=outbound
EMAIL_FROM=noreply@yourdomain.com
ALERT_EMAIL_TO=your@email.com

# ── DocuSeal (e-signatures) ──────────────────────────────────────────────────
# deploy.sh generates DOCUSEAL_SECRET_KEY_BASE automatically
DOCUSEAL_SECRET_KEY_BASE=REPLACE_WITH_SECRET
# After first deploy, log into sign.yourdomain.com → API → copy the key here,
# then restart: docker compose -f docker-compose.prod.yml restart app worker
DOCUSEAL_API_KEY=
DOCUSEAL_WEBHOOK_SECRET=

# ── AI (optional — leave empty, users bring their own keys) ──────────────────
# You can set global keys here if you want to offer managed AI,
# or leave empty and let each user configure their own in Settings.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── CRM Integrations (optional — required only if enabling CRM features) ──────
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=

# ── Google Drive Import (optional — required only if enabling Google Drive import)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Observability ─────────────────────────────────────────────────────────────
OTEL_ENABLED=false            # Set to true to enable OpenTelemetry tracing
OTEL_SERVICE_NAME=clauseflow  # Service name shown in traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318  # OTLP HTTP endpoint (Jaeger, Tempo, Datadog, etc.)
