# ── Logging ───────────────────────────────────────────────────────────────────
# Pino log level: trace | debug | info | warn | error | fatal
# Defaults to "debug" in development, "info" in production.
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────
# DATABASE_URL  — pooled connection, used for every runtime query.
# DIRECT_URL    — direct (non-pooled) connection, used ONLY by `prisma migrate`.
#                 Migrations take a Postgres advisory lock and run DDL, neither of
#                 which survives a transaction-mode pooler. This is not optional on
#                 Supabase — migrations will hang or fail against port 6543.
#
# Supabase (Project → Connect) — pooled and direct differ by PORT:
#   DATABASE_URL=postgresql://postgres.<ref>:<pw>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#   DIRECT_URL=postgresql://postgres.<ref>:<pw>@aws-1-<region>.pooler.supabase.com:5432/postgres
#
# Neon — pooled and direct differ by HOSTNAME (both 5432); the pooled host contains
# "-pooler". The Vercel integration injects both automatically; leave its Custom
# Prefix field empty so the default names are used.
#   DATABASE_URL=postgresql://<user>:<pw>@ep-<id>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
#   DIRECT_URL=postgresql://<user>:<pw>@ep-<id>.<region>.aws.neon.tech/<db>?sslmode=require
#
# Self-hosted Postgres: set DATABASE_URL only; DIRECT_URL falls back to it.
#
# Aliases (first non-empty wins) — these are the names the managed hosts inject,
# so a linked project needs no manual copying:
#   DATABASE_URL  ← POSTGRES_PRISMA_URL ← POSTGRES_URL
#   DIRECT_URL    ← DATABASE_URL_UNPOOLED (Neon) ← POSTGRES_URL_NON_POOLING (Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/clauseflow
DIRECT_URL=
# Required when running via docker-compose; postgres container will refuse to
# boot without it. Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=
# Postgres connection pool size per process (app + worker each).
# Leave empty to use the default: 1 on Vercel (each lambda opens its own pool, and
# the Supabase pooler is doing the real pooling), 20 everywhere else.
DATABASE_POOL_SIZE=

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED — generate with: openssl rand -base64 32
# docker-compose will refuse to start the app container if this is empty.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NEXT_PUBLIC_APP_NAME: product name shown in the UI, page titles and email
# subjects. Set it to rebrand a self-hosted install; defaults to "Aakd".
# Read at build time, so a change requires a rebuild of the web image.
# Deliberately does NOT rename the MCP server, the storage bucket, the theme
# cookie or the mail-from domain — those are stable identifiers.
NEXT_PUBLIC_APP_NAME=
# INTERNAL_APP_URL: used for SSR self-requests (e.g. analytics page fetching its own API).
# Set this to the container-internal address when running in Docker (e.g. http://app:3000)
# so the server-side fetch does not route through the public URL which is unreachable inside
# the container network.
INTERNAL_APP_URL=http://localhost:3000

# ── Storage (S3-compatible: AWS S3, Cloudflare R2, MinIO) ────────────────────
# Leave STORAGE_ENDPOINT empty for AWS S3, set for MinIO or other S3-compatible.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=clauseflow
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
#
# Cloudflare R2 — set these instead of the STORAGE_* block above. The endpoint is
# derived from the account id and the region is forced to "auto" (R2 has no
# regions but SigV4 still requires a value).
# Create the credentials at: Cloudflare dashboard → R2 → Manage API tokens →
# Create API token, scoped "Object Read & Write" on your bucket.
#   R2_ACCOUNT_ID        — the 32-char hex id in your R2 endpoint / dashboard URL
#   R2_ACCESS_KEY_ID     — from the R2 API token
#   R2_SECRET_ACCESS_KEY — from the R2 API token (shown once)
#   R2_BUCKET            — bucket name
# Aliases: STORAGE_ACCESS_KEY ← R2_ACCESS_KEY_ID, STORAGE_SECRET_KEY ←
# R2_SECRET_ACCESS_KEY, STORAGE_BUCKET ← R2_BUCKET / R2_BUCKET_NAME,
# R2_ACCOUNT_ID ← CLOUDFLARE_ACCOUNT_ID. Explicit STORAGE_* always wins.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── AI (required for M1 AI extraction — optional, degrades gracefully without)
# AI_PROVIDER auto-detects from which key is set. Override explicitly if needed.
# Values: anthropic | openai | ollama
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# OLLAMA_EMBEDDING_MODEL: Embedding model to use with Ollama (self-hosted embeddings).
# IMPORTANT: must produce 1536-dim vectors to match the ContractEmbedding column.
# The default `nomic-embed-text` model produces 768-dim vectors and WILL FAIL.
# Use a 1536-dim model such as `mxbai-embed-large` instead.
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large

# AI_EXTRACTION_LONG_DOC_MODEL: optional. Anthropic only.
# Contracts longer than the extraction page budget (30 pages) normally have a
# selection of pages sent to the model — head, tail, and any middle pages that
# mention a relevant clause — which keeps cost bounded and predictable.
# Set this to a larger-context model (e.g. claude-sonnet-5) to send long
# documents whole instead. Left unset by design: upgrading the model silently
# would change what you pay per contract without asking.
AI_EXTRACTION_LONG_DOC_MODEL=

# ── Email (required for M1 renewal alerts — optional, app works without) ──────
# Two ways to configure delivery. Postmark is checked first; if no Postmark token
# is set the generic SMTP block is used. With neither, email is disabled and all
# sends become no-ops (in-app + Slack/Teams notifications still fire).
#
# Option 1 — Postmark (recommended)
# Postmark dashboard → Servers → your server → API Tokens → Server API Token.
# The same token is used as both SMTP username and password.
# The From address MUST be a confirmed Sender Signature or a verified domain,
# otherwise Postmark rejects the message.
# Aliases: POSTMARK_SERVER_TOKEN ← POSTMARK_API_TOKEN ← POSTMARK_TOKEN ← POSTMARK_API_KEY
POSTMARK_SERVER_TOKEN=
# Message stream to route through. "outbound" is the default transactional stream
# every Postmark server ships with; set this only if you use a custom stream.
POSTMARK_MESSAGE_STREAM=outbound
#
# Option 2 — generic SMTP (self-hosted relay, SES, Mailgun, ...)
# Leave SMTP_HOST empty to skip.
SMTP_HOST=
SMTP_PORT=587
# Set SMTP_SECURE=true for TLS (port 465), false for STARTTLS (port 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
#
# From address for all outbound mail. Aliases: EMAIL_FROM ← SMTP_FROM ← POSTMARK_FROM
EMAIL_FROM=noreply@yourcompany.com
# Comma-separated list of recipients for alert emails
ALERT_EMAIL_TO=

# ── Redis (required for BullMQ job queues) ───────────────────────────────────
REDIS_URL=redis://localhost:6379
# For Upstash (Vercel + Fly.io cloud deployments) use rediss:// (TLS):
#   REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
# The app and worker detect the rediss:// scheme automatically and enable TLS.
# Optional — when set, the docker-compose redis container starts with
# `--requirepass`. Update REDIS_URL to redis://:${REDIS_PASSWORD}@redis:6379
# in your env when running via docker-compose with a password.
REDIS_PASSWORD=

# ── E-signature (DocuSeal) — self-hosted at port 3001 or use DocuSeal Cloud ──
# DOCUSEAL_API_URL: omit (or set to https://api.docuseal.com) to use DocuSeal Cloud.
# For docker-compose self-hosted set to http://localhost:3001 (or http://docuseal:3000 inside Docker).
DOCUSEAL_API_URL=http://localhost:3001
DOCUSEAL_API_KEY=your_docuseal_api_key
# Required — reject all DocuSeal webhook events if not set (fail-secure).
# All incoming webhook requests must carry a valid HMAC-SHA256 signature in the
# X-DocuSeal-Signature header. Set this in the DocuSeal dashboard → Webhooks section.
# Without this variable the webhook handler returns 403 for every request.
DOCUSEAL_WEBHOOK_SECRET=your_docuseal_webhook_secret_here
# DOCUSEAL_SECRET_KEY_BASE: Required only for docker-compose self-hosted DocuSeal.
# Generate with: openssl rand -hex 64
DOCUSEAL_SECRET_KEY_BASE=

# ── Encryption (for API keys stored in DB) ────────────────────────────────────
ENCRYPTION_KEY=

# ── Slack / Teams webhook alerts (optional — degrades gracefully when not set) ─
# Slack incoming webhook URL
# Create at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Microsoft Teams incoming webhook URL
# Create at: Teams channel → Connectors → Incoming Webhook
TEAMS_WEBHOOK_URL=

# ── Encryption key for stored third-party secrets (hex-encoded 32 bytes) ─────
# REQUIRED for Slack/Teams/webhook routing, CRM OAuth tokens, and the Microsoft
# Entra ID client secret. Rotating it makes every stored secret unreadable —
# each integration then has to be reconnected.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIFICATION_ENCRYPTION_KEY=

# ── Microsoft Entra ID (single sign-on + contract responsibility) ────────────
# There is nothing to set here. Entra is configured per organization, in
# Settings → Microsoft Entra ID: each org registers its own app registration in
# its own tenant and pastes the client id and secret, so one deployment can
# serve several companies without them sharing an app registration.
#
# The two redirect URIs an org needs to register are derived from
# NEXT_PUBLIC_APP_URL (falling back to BETTER_AUTH_URL) and are shown on that
# settings page:
#   <app-url>/api/auth/entra/callback     — sign-in
#   <app-url>/api/entra/consent/callback  — admin consent

# ── M6 Authoring (DOCX export) ───────────────────────────────────────────────
# Optional — font family used in exported .docx files (default: Times New Roman)
DOCX_EXPORT_FONT=

# ── CRM Integrations (optional — required only if enabling CRM features) ──────
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=

# ── Google Drive Import (optional — required only if enabling Google Drive import)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Observability ─────────────────────────────────────────────────────────────
OTEL_ENABLED=false            # Set to true to enable OpenTelemetry tracing
OTEL_SERVICE_NAME=clauseflow  # Service name shown in traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318  # OTLP HTTP endpoint (Jaeger, Tempo, Datadog, etc.)
